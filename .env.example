# Configuração do Banco de Dados Principal (PostgreSQL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=harmonista
PG_PASSWORD=
PG_DBNAME=harmonista
PG_SSLMODE=required
PG_CERTIFICATE=aiven.cert

# Analytics via Redis (opcional - se Redis não estiver acessível, analytics será desabilitado)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Segurança e Sessões
SESSION_KEY=LONG_LONG_KEY
SESSION_SECRET=LONG_LONG_SECRET

# Domínio
# Em desenvolvimento: http://localhost
# Em produção com SSL: https://seudominio.com
DOMAIN=https://harmonista.org

# Configuração de Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@harmonista.org

# Porta da aplicação (nginx faz proxy reverso)
PORT=8080

# configuiração para Backup
# Cloudflare R2 - Configurações de Backup
R2_ENDPOINT=
R2_SECRET_KEY=
R2_BUCKET=
R2_ACCESS_KEY=

#email para acessar o backoffice, é a mesma senha do sistema
BACKOFFICE_EMAILS=